# 数据库密码（生产环境必须修改）
POSTGRES_PASSWORD=yingo123

# 安全密钥（生产环境必须修改）
PEPPER_SECRET=dev-pepper-change-in-production
TOKEN_SECRET=dev-token-secret-change-in-production
INTERNAL_API_KEY=dev-internal-key-change-in-production

# 管理员用户名（可选，第一个注册的用户自动成为 admin）
